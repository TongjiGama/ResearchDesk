{
  "name": "research-workbench",
  "version": "1.0.0",
  "description": "科研台 ResearchDesk — 本地优先的个人科研工作台：检索 / 论文 / 灵感 / 实验 / 学术谱系",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js --dev",
    "package": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.researchworkbench.portable",
    "productName": "科研台",
    "copyright": "Copyright © 2026",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "asar": true,
    "extraMetadata": {
      "version": "3.0.0"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app.ico",
      "src/**/*",
      "app-data/**/*",
      "!data/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!.tmp/**/*",
      "!shot-*.png",
      "!migrate.js",
      "!start.js",
      "!launch.vbs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "app.ico",
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "科研台-v3.0-win-x64-便携版.${ext}"
    }
  },
  "author": "李东谚",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0"
  }
}
